rules_version = '2';

// Phase 1 - Foundation. Deny by default; every allow below is explicit.
//
// The trust boundary is the Firebase Auth custom claims (`role`, `clinicId`,
// `platformAdmin`), never a Firestore field - claims can only be set by the
// Cloud Functions running with the Admin SDK (createClinicAndOwner, acceptInvite,
// updateStaffRole, onPlatformAdminWrite), so a client can never grant itself
// access to another tenant by writing a document.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isPlatformAdmin() {
      return isSignedIn() && request.auth.token.platformAdmin == true;
    }

    function belongsToTenant(clinicId) {
      return isSignedIn() && request.auth.token.clinicId == clinicId;
    }

    function isOwnerOfTenant(clinicId) {
      return belongsToTenant(clinicId) && request.auth.token.role == 'owner';
    }

    function isReceptionistOfTenant(clinicId) {
      return belongsToTenant(clinicId) && request.auth.token.role == 'receptionist';
    }

    function isAssistantOfTenant(clinicId) {
      return belongsToTenant(clinicId) && request.auth.token.role == 'assistant';
    }

    // Explicit, spelled-out exclusion (not just relying on the default deny) so the
    // intent reads clearly: Lab Coordinator has zero access to the patient-records
    // module, full stop - the same as any other role that isn't owner/receptionist/
    // assistant, but called out because it's the one role a reviewer might otherwise
    // assume falls under "any staff member of the tenant".
    function isLabCoordinatorOfTenant(clinicId) {
      return belongsToTenant(clinicId) && request.auth.token.role == 'labCoordinator';
    }

    // Patient records are clinical/PII data - deliberately not extended to platform
    // admins the way tenants/staff read access is. No cross-tenant support visibility
    // into patient data in this phase.
    function canReadPatientRecords(clinicId) {
      return (isOwnerOfTenant(clinicId) || isReceptionistOfTenant(clinicId) ||
        isAssistantOfTenant(clinicId)) && !isLabCoordinatorOfTenant(clinicId);
    }

    // Fields only clinical staff (owner/assistant) may set - a receptionist's write
    // must never touch these, on create or update.
    function clinicalFields() {
      return ['allergies', 'chronicConditions', 'currentMedications', 'medicalHistoryNotes'];
    }

    // Demographic/contact fields that stay receptionist/owner territory - an
    // assistant's write must never touch these.
    function demographicFields() {
      return ['name', 'dob', 'gender', 'phone', 'email', 'address',
        'emergencyContactName', 'emergencyContactPhone', 'bloodGroup'];
    }

    function touchesNoneOf(fieldList) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(fieldList);
    }

    // Phase 4a - the inverse of touchesNoneOf(): every affected key must be in the
    // allow-list, used to give the receptionist a narrow write onto the otherwise
    // owner-only tenant doc (just enough to bump the sequential invoice counter, see
    // below - nothing else on that doc becomes receptionist-writable).
    function touchesOnly(fieldList) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fieldList);
    }

    // Referential integrity for Phase 2b: an appointment/waitlist entry may only point
    // at a patient that actually exists in this tenant. Enforced here with exists(),
    // not a Cloud Function trigger, because a trigger only runs *after* the write has
    // already committed - there'd be a real window where an invalid appointment is
    // sitting in Firestore (and visible to any listener, e.g. the calendar) before the
    // function could react to it. exists() runs as part of the same atomic write
    // evaluation, so a bad reference is rejected before it's ever persisted, with no
    // race window and no cleanup job needed.
    function patientExists(clinicId, patientId) {
      return exists(/databases/$(database)/documents/tenants/$(clinicId)/patients/$(patientId));
    }

    // Phase 4c - an insurance claim must point at a real invoice in this tenant,
    // same reasoning as patientExists() above.
    function invoiceExists(clinicId, invoiceId) {
      return exists(/databases/$(database)/documents/tenants/$(clinicId)/invoices/$(invoiceId));
    }

    // An appointment's end must be after its start, on every write - not just create,
    // since a reschedule (update) can just as easily submit a reversed pair. Compared
    // directly (not type-checked as `timestamp`) since the two sides just need to be
    // ordered consistently, whatever comparable type the client sends them as.
    function validAppointmentTimes() {
      return request.resource.data.endTime > request.resource.data.startTime;
    }

    // Phase 3a - diagnostic tooth-condition markings are dentist-only; a hygienist's
    // routine periodontal-reading update must never also smuggle in a diagnosis.
    function diagnosticChartingFields() {
      return ['toothConditions'];
    }

    // Only a platform admin may read/write their own admin doc. This collection is
    // intentionally separate from the clinic signup/invite flow - nothing here ever
    // grants platformAdmin; only the onPlatformAdminWrite Cloud Function's trigger
    // (seeded by an existing admin) sets that custom claim.
    match /platformAdmins/{uid} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;
    }

    match /tenants/{clinicId} {
      // Platform admins get read-only visibility across all tenants for support/ops;
      // they get no write allowance here by design - clinic data mutation stays with
      // the clinic's own owner and the Cloud Functions, not a blanket admin bypass.
      allow read: if belongsToTenant(clinicId) || isPlatformAdmin();

      // Phase 4a - invoiceCounter (the sequential INV-0001 counter) is bumped inside
      // the same transaction that creates an invoice, and the receptionist creates
      // invoices too (see the invoices match block below) - so they need to touch this
      // one field on an otherwise owner-only document. touchesOnly() keeps every other
      // field on this doc (clinicName, gstin, state, ...) owner-exclusive as before.
      allow write: if isOwnerOfTenant(clinicId) ||
        (isReceptionistOfTenant(clinicId) && touchesOnly(['invoiceCounter']));

      match /staff/{staffUid} {
        allow read: if belongsToTenant(clinicId) || isPlatformAdmin();
        allow write: if isOwnerOfTenant(clinicId);
      }

      // Invites are only ever written by the owner (from the app) or by the
      // acceptInvite Cloud Function (Admin SDK, bypasses these rules entirely) -
      // an invited user never needs direct Firestore access to accept their own
      // invite.
      match /invites/{inviteId} {
        allow read, write: if isOwnerOfTenant(clinicId);
      }

      // Written only by Cloud Functions (Admin SDK). Owners can read their own
      // clinic's history; nobody writes from the client, ever.
      match /auditLog/{logId} {
        allow read: if isOwnerOfTenant(clinicId);
        allow write: if false;
      }

      // Phase 2a - patient records, EDR, and DPDP consent capture.
      match /patients/{patientId} {
        allow read: if canReadPatientRecords(clinicId);

        // Only owner/receptionist create patients. A receptionist-authored create
        // may not seed any clinical field - those start empty and are added later
        // by an assistant/owner.
        allow create: if isOwnerOfTenant(clinicId) ||
          (isReceptionistOfTenant(clinicId) &&
            !request.resource.data.keys().hasAny(clinicalFields()));

        allow update: if isOwnerOfTenant(clinicId) ||
          (isReceptionistOfTenant(clinicId) && touchesNoneOf(clinicalFields())) ||
          (isAssistantOfTenant(clinicId) && touchesNoneOf(demographicFields()));

        // Only the owner deletes a patient record - not part of this phase's UI,
        // but the rule shouldn't be laxer than what's actually offered.
        allow delete: if isOwnerOfTenant(clinicId);

        // Consents are separate, revocable, queryable facts (see README) - owner and
        // receptionist (who runs the intake flow) capture them; assistant gets the
        // same read access as the rest of the record but doesn't record consent.
        match /consents/{consentType} {
          allow read: if canReadPatientRecords(clinicId);
          allow write: if isOwnerOfTenant(clinicId) || isReceptionistOfTenant(clinicId);
        }

        // Signed intake form snapshots - same write access as consents.
        match /intakeForms/{formId} {
          allow read: if canReadPatientRecords(clinicId);
          allow write: if isOwnerOfTenant(clinicId) || isReceptionistOfTenant(clinicId);
        }
      }

      // DPDP access/correction/erasure request log. Owner-only, full stop - this
      // phase only logs and tracks the request, so there's no reason for anyone
      // else to see or touch it yet.
      match /dataRequests/{requestId} {
        allow read, write: if isOwnerOfTenant(clinicId);
      }

      // Phase 2b - scheduling & calendar. Owner/receptionist have full CRUD;
      // assistant is read-only (they need to know who's coming in, per the calendar
      // screen, but scheduling itself stays an administrative/front-desk action).
      // Lab Coordinator isn't in this allow list at all - the same total exclusion
      // as the patient records module, just via omission rather than a named
      // function here (there's no "everyone but Lab Coordinator" read case to guard,
      // unlike canReadPatientRecords()).
      match /appointments/{appointmentId} {
        allow read: if isOwnerOfTenant(clinicId) || isReceptionistOfTenant(clinicId) ||
          isAssistantOfTenant(clinicId);

        allow create: if (isOwnerOfTenant(clinicId) || isReceptionistOfTenant(clinicId)) &&
          patientExists(clinicId, request.resource.data.patientId) &&
          validAppointmentTimes();

        allow update: if (isOwnerOfTenant(clinicId) || isReceptionistOfTenant(clinicId)) &&
          patientExists(clinicId, request.resource.data.patientId) &&
          validAppointmentTimes();

        allow delete: if isOwnerOfTenant(clinicId) || isReceptionistOfTenant(clinicId);
      }

      // Waitlist management stays with owner/receptionist, same as the rest of
      // scheduling - not mentioned as part of the assistant's calendar-viewing scope,
      // so (per the deny-by-default default) they get no access here at all.
      match /waitlist/{entryId} {
        allow read: if isOwnerOfTenant(clinicId) || isReceptionistOfTenant(clinicId);

        allow create: if (isOwnerOfTenant(clinicId) || isReceptionistOfTenant(clinicId)) &&
          patientExists(clinicId, request.resource.data.patientId);

        allow update: if (isOwnerOfTenant(clinicId) || isReceptionistOfTenant(clinicId)) &&
          patientExists(clinicId, request.resource.data.patientId);

        allow delete: if isOwnerOfTenant(clinicId) || isReceptionistOfTenant(clinicId);
      }

      // Phase 3a - odontogram & periodontal charting. Owner/dentist has full CRUD,
      // including the diagnostic toothConditions field. Assistant/hygienist can read
      // the whole document (they need the full picture to work from) but may only
      // ever write periodontalChart - taking pocket-depth/bleeding/mobility readings
      // is routinely their job, but diagnosis stays the dentist's call. Receptionist
      // and Lab Coordinator get no access at all, same total exclusion as scheduling
      // and patient records - clinical charting/diagnosis is out of scope for both.
      match /chartings/{chartingId} {
        allow read: if isOwnerOfTenant(clinicId) || isAssistantOfTenant(clinicId);

        allow create: if isOwnerOfTenant(clinicId) &&
          patientExists(clinicId, request.resource.data.patientId);

        allow update: if (isOwnerOfTenant(clinicId) &&
            patientExists(clinicId, request.resource.data.patientId)) ||
          (isAssistantOfTenant(clinicId) &&
            patientExists(clinicId, request.resource.data.patientId) &&
            touchesNoneOf(diagnosticChartingFields()));

        allow delete: if isOwnerOfTenant(clinicId);
      }

      // Treatment plans - owner/dentist only for anything beyond reading. Assistant
      // gets the same full-record read as chartings (they should see what's planned)
      // but no write of any kind: creating, editing, and approving a plan are all
      // dentist/owner judgment calls, not a hygienist's.
      match /treatmentPlans/{planId} {
        allow read: if isOwnerOfTenant(clinicId) || isAssistantOfTenant(clinicId);

        allow create: if isOwnerOfTenant(clinicId) &&
          patientExists(clinicId, request.resource.data.patientId);

        allow update: if isOwnerOfTenant(clinicId) &&
          patientExists(clinicId, request.resource.data.patientId);

        allow delete: if isOwnerOfTenant(clinicId);
      }

      // Phase 3b - X-ray/imaging metadata. Same real-world split as Phase 3a's
      // periodontal readings: capturing an image is routinely an assistant/hygienist's
      // job, so they get create/read/update (tagging: tooth number, type, notes) same
      // as the owner/dentist - but deleting a clinical record is owner-only, both for
      // record-integrity reasons and because an accidental/malicious deletion of
      // patient imaging is a bigger risk than a tagging mistake. Receptionist and Lab
      // Coordinator get no access at all, same total exclusion as the rest of the
      // clinical module.
      match /imaging/{imageId} {
        allow read: if isOwnerOfTenant(clinicId) || isAssistantOfTenant(clinicId);

        allow create: if (isOwnerOfTenant(clinicId) || isAssistantOfTenant(clinicId)) &&
          patientExists(clinicId, request.resource.data.patientId);

        allow update: if (isOwnerOfTenant(clinicId) || isAssistantOfTenant(clinicId)) &&
          patientExists(clinicId, request.resource.data.patientId);

        allow delete: if isOwnerOfTenant(clinicId);
      }

      // Phase 4a - GST invoicing. Owner/receptionist have full CRUD - the spec is
      // explicit that billing (generate/send invoices, record payments) is a
      // receptionist-level duty here, same as the owner. Assistant/hygienist and Lab
      // Coordinator get a clean full exclusion: no allow clause mentions them at all,
      // so both their read and write fail on the default deny below - unlike the
      // clinical modules' partial-field carve-outs (e.g. imaging/chartings), there is
      // no "assistant may touch some fields" case in this collection.
      match /invoices/{invoiceId} {
        allow read: if isOwnerOfTenant(clinicId) || isReceptionistOfTenant(clinicId);

        allow create: if (isOwnerOfTenant(clinicId) || isReceptionistOfTenant(clinicId)) &&
          patientExists(clinicId, request.resource.data.patientId);

        allow update: if (isOwnerOfTenant(clinicId) || isReceptionistOfTenant(clinicId)) &&
          patientExists(clinicId, request.resource.data.patientId);

        allow delete: if isOwnerOfTenant(clinicId) || isReceptionistOfTenant(clinicId);
      }

      // Phase 4c - insurance/TPA claim tracking, closing out Billing & Financial
      // Management. Same access shape as invoices above (a financial/administrative
      // matter, not clinical): owner/receptionist full CRUD, clean full exclusion for
      // assistant/labCoordinator. A claim must reference both a real patient and a
      // real invoice in this tenant.
      match /insuranceClaims/{claimId} {
        allow read: if isOwnerOfTenant(clinicId) || isReceptionistOfTenant(clinicId);

        allow create: if (isOwnerOfTenant(clinicId) || isReceptionistOfTenant(clinicId)) &&
          patientExists(clinicId, request.resource.data.patientId) &&
          invoiceExists(clinicId, request.resource.data.invoiceId);

        allow update: if (isOwnerOfTenant(clinicId) || isReceptionistOfTenant(clinicId)) &&
          patientExists(clinicId, request.resource.data.patientId) &&
          invoiceExists(clinicId, request.resource.data.invoiceId);

        allow delete: if isOwnerOfTenant(clinicId) || isReceptionistOfTenant(clinicId);
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
